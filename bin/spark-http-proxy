  show_usage
  echo ""
  echo "Environment Variables:"
  echo ""
  echo "  Customize DNS behavior:"
  echo "    HTTP_PROXY_DNS_TLDS=dev,local    # Proxy multiple domains (default: loc)"
  echo "    HTTP_PROXY_DNS_TARGET_IP=10.0.0.1 # Route to different IP (default: 127.0.0.1)"
  echo "    HTTP_PROXY_DNS_PORT=5353          # Use different DNS port (default: 19322)"
  echo ""
  echo "  Enable tailnet peer routing (off by default):"
  echo "    HTTP_PROXY_TAILSCALE_ENABLED=true      # Forward a hostname served by another machine"
  echo "    HTTP_PROXY_TAILSCALE_SOURCE=socket     # override; detected from the host by default"
  echo "    HTTP_PROXY_TAILSCALE_REFRESH_INTERVAL=60s # how often peers are re-read"
  echo "    HTTP_PROXY_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock"
  echo ""
  echo "  Use specific image version:"
  echo "    HTTP_PROXY_DOCKER_IMAGE_TAG=v1.2.3 # Pin to specific version (default: latest)"
  echo ""
  echo "  Usage examples:"
  echo "    HTTP_PROXY_DNS_TLDS=dev,staging ${0} start"
  echo "    HTTP_PROXY_DOCKER_IMAGE_TAG=v1.2.3 ${0} start-with-metrics"
  echo ""
  echo "Tailnet Peer Routing:"
  echo "  A hostname served by a container on one of your machines is reachable, under"
  echo "  the same name, from your other machines on the same tailnet."
  echo "  • Only machines belonging to your Tailscale account are used, always"
  echo "  • A hostname served locally is answered locally and never forwarded"
  echo "  • Enabling it makes local containers reachable from your other devices"
  echo "  • macOS: run '''${0} tailscale-status''' on a schedule to keep discovery current"
  echo ""
  echo "System DNS Integration:"
  echo "  The 'configure-dns' command sets up automatic domain resolution:"
  echo "  • macOS: Creates /etc/resolver files for seamless *.loc domain resolution"
  echo "  • Linux: Configures systemd-resolved for domain-specific DNS routing"
  echo "  • Eliminates manual /etc/hosts file editing"
}

install_mkcert() {
  if command -v mkcert >/dev/null 2>&1; then
    log_info "Running mkcert -install to ensure root CA is installed..."
    mkcert -install
    return 0
  fi

  # Try different package managers based on availability
  if command -v brew >/dev/null 2>&1; then
    log_info "Installing mkcert with Homebrew..."
    if brew install mkcert nss && mkcert -install; then
      log_success "mkcert installed successfully"
      return 0
    else
      log_error "Failed to install mkcert with Homebrew"
      return 1
    fi
  elif command -v pacman >/dev/null 2>&1; then
    log_info "Installing mkcert with pacman..."
    if sudo pacman -S --noconfirm nss mkcert && mkcert -install; then
      log_success "mkcert installed successfully"
      return 0
    else
      log_error "Failed to install mkcert with pacman"
      return 1
    fi
  else
    log_error "mkcert not found and no supported package manager available"
    log_info "Please install mkcert manually:"
    log_info "  - Arch Linux: sudo pacman -S nss mkcert"
    log_info "  - macOS: brew install mkcert nss"
    return 1
  fi
}

# Applies a certificate change to the proxy. Traefik serves a certificate only
# when the dynamic configuration references it, and that reference is written by
# the container's certificate scan, so re-running the scan is what applies a
# change. A restart applies it too, by running the same scan on the way up, but
# it drops every connection on the machine.
apply_certificates() {
  if ! is_running http-proxy; then
    log_info "The proxy is not running. The change applies when it starts."
    return 0
  fi

  # An image predating the scan guard would pass --tls-only through to Traefik
  # and run the rest of its entrypoint on the way, withdrawing peer routes.
  # The guard itself, not the flag anywhere in the file. A mention in a comment
  # would otherwise read as support and send the scan to an entrypoint that runs
  # its whole body, withdrawing peer routes on the way. A pattern that stops
  # matching costs a restart, which still applies the certificate, so the
  # tighter test fails in the safe direction.
  if docker exec http-proxy grep -qE '^[[:space:]]*if .*--tls-only' /entrypoint.sh 2>/dev/null; then
    log_info "Applying certificates..."
    # Only the proxy knows why a scan failed, and without its message the
    # warning says a thing did not work and nothing about what to look at.
    local scan_error
    if ! scan_error="$(docker exec http-proxy /entrypoint.sh --tls-only 2>&1 >/dev/null)"; then
      log_warning "The proxy did not apply the certificates"
      if [ -n "${scan_error}" ]; then
        log_info "The proxy said: ${scan_error}"
      fi
      log_info "Apply them with: $(basename "${0}") restart"
      # The certificate exists but the proxy is not serving it, so the command
      # did not do what it says it does. Reporting success here would have a
      # script move on to a hostname that is not answering yet.
      return 1
    fi
    return 0
  fi

  # An older proxy cannot run the scan on its own, and nothing references a new
  # certificate, so nothing would ever apply it. The restart runs the scan.
  log_info "Restarting Traefik to apply the change..."
  dc_cmd restart traefik
}

generate_mkcert() {
  local domain="$1"

  if [ -z "${domain}" ] && [ -t 0 ]; then
    read -rp "Enter domain name: " domain
  fi

  if [ -z "${domain}" ]; then
    log_error "Domain name required"
    exit 1
  fi

  if ! reject_path_in_domain "${domain}"; then
    exit 1
  fi

  if ! install_mkcert; then
    exit 1
  fi

  # Create a safe filename for wildcard domains
  local safe_filename
  safe_filename="$(cert_safe_filename "${domain}")"

  log_info "Generating certificates for: ${domain}"
  log_info "Certificate files will be named: ${safe_filename}.pem and ${safe_filename}-key.pem"

  mkcert -cert-file "${CERT_DIR}/${safe_filename}.pem" \
    -key-file "${CERT_DIR}/${safe_filename}-key.pem" \
    "${domain}"

  log_success "Certificates generated successfully:"
  log_info "  Certificate: ${CERT_DIR}/${safe_filename}.pem"
  log_info "  Private key: ${CERT_DIR}/${safe_filename}-key.pem"

  apply_certificates
}

# Reject a certificate argument that names a path rather than a hostname.
# A certificate covers a hostname, and a container mounted under a path with
# VIRTUAL_PATH is served by the certificate of the host it sits on. Without this
# check the path would be folded into the filename and the request would half
# succeed, leaving a certificate nothing can use.
reject_path_in_domain() {
  local domain="$1"

  if [[ "${domain}" == */* ]]; then
    log_error "'${domain}' contains a path. A certificate covers a hostname."
    log_info "Use the hostname on its own: ${domain%%/*}"
    log_info "A container mounted with VIRTUAL_PATH is served by its host's certificate."
    return 1
  fi

  return 0
}

# Derive the safe filename used to store a domain's certificate files
cert_safe_filename() {
  local domain="$1"
  local safe_filename="${domain}"
  # Replace * with _wildcard_ for filename safety
  safe_filename="${safe_filename//\*/_wildcard_}"
  # Replace other problematic characters
  safe_filename="${safe_filename//\//_}"
  echo "${safe_filename}"
}

# List installed certificates in the cert directory
list_certs() {
  log_info "Certificate directory: ${CERT_DIR}"

  local found=0
  local cert_file
  for cert_file in "${CERT_DIR}"/*.pem; do
    # Guard against the literal glob when no files match
    [[ -e "${cert_file}" ]] || break
    # Skip key files; they are listed alongside their certificate
    [[ "${cert_file}" == *-key.pem ]] && continue

    local safe_filename
    safe_filename="$(basename "${cert_file}" .pem)"
    # Reverse the safe-filename mapping for display
    local domain="${safe_filename//_wildcard_/\*}"

    echo ""
    log_success "${domain}"
    log_info "  Certificate: ${cert_file}"
    local key_file="${CERT_DIR}/${safe_filename}-key.pem"
    if [[ -f "${key_file}" ]]; then
      log_info "  Private key: ${key_file}"
    else
      log_warning "  Private key missing: ${key_file}"
    fi
    found=$((found + 1))
  done

  if [[ "${found}" -eq 0 ]]; then
    echo ""
    log_warning "No certificates found. Generate one with: $(basename "${0}") generate-mkcert '*.spark.loc'"
    return 0
  fi

  echo ""
  log_info "${found} certificate(s) installed"
  # A domain just listed, so the line works when it is copied.
  log_info "Remove one with: $(basename "${0}") remove-cert '${domain}'"
}

# Remove installed certificate pairs for one or more domains
remove_cert() {
  if [ "$#" -eq 0 ]; then
    local -a prompted=()
    if [ -t 0 ]; then
      read -rp "Enter domain name(s) to remove: " -a prompted
      set -- "${prompted[@]}"
    fi
  fi

  if [ "$#" -eq 0 ]; then
    log_error "Domain name required"
    exit 1
  fi

  local -a files=()
  local -a matched=()
  local -a missing=()
  local domain safe_filename cert_file key_file
  for domain in "$@"; do
    if ! reject_path_in_domain "${domain}"; then
      exit 1
    fi
    safe_filename="$(cert_safe_filename "${domain}")"
    cert_file="${CERT_DIR}/${safe_filename}.pem"
    key_file="${CERT_DIR}/${safe_filename}-key.pem"

    if [[ ! -f "${cert_file}" && ! -f "${key_file}" ]]; then
      missing+=("${domain}")
      continue
    fi

    log_warning "Will remove certificate for: ${domain}"
    [[ -f "${cert_file}" ]] && { log_info "  Certificate: ${cert_file}"; files+=("${cert_file}"); }
    [[ -f "${key_file}" ]] && { log_info "  Private key: ${key_file}"; files+=("${key_file}"); }
    matched+=("${domain}")
  done

  for domain in "${missing[@]}"; do
    log_error "No certificate found for domain: ${domain}"
  done

  if [[ "${#matched[@]}" -eq 0 ]]; then
    log_info "List installed certificates with: $(basename "${0}") list-certs"
    exit 1
  fi

  if [ ! -t 0 ]; then
    log_error "Cannot confirm removal without a terminal, so nothing was removed"
    log_info "Re-run this interactively to confirm"
    exit 1
  fi

  read -p "Remove ${#matched[@]} certificate(s)? (y/N): " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    log_info "Removal cancelled"
    return 0
  fi

  rm -f "${files[@]}"
  log_success "Removed ${#matched[@]} certificate(s): ${matched[*]}"

  apply_certificates
}

open_dashboard() {
  local port
  port=$(get_service_port traefik 8080)
  if [[ -z "${port}" ]]; then
    log_error "Traefik dashboard port not found. Is the proxy running?"
    exit 1
  fi
  open_url "http://localhost:${port}" "Traefik dashboard"
}

# Reports monitoring being off apart from its services not answering.
require_metrics_running() {
  if [[ "${METRICS_ENABLED}" != "true" ]]; then
    log_error "Monitoring is not enabled"
    log_info "Start it with: ${0} start-with-metrics"
    return 1
  fi
  if ! is_running prometheus; then
    log_error "Monitoring is enabled but its services are not running"
    log_info "Start them with: ${0} start-with-metrics"
    return 1
  fi
}

open_grafana() {
  local port
  require_metrics_running || exit 1
  port=$(get_service_port grafana 3000)
  if [[ -z "${port}" ]]; then
    log_error "Grafana port not found"
    log_info "Try starting with: ${0} start-with-metrics"
    exit 1
  fi
  open_url "http://localhost:${port}" "Grafana dashboard" "Login: admin/admin"
}

open_prometheus() {
  local port
  require_metrics_running || exit 1
  port=$(get_service_port prometheus 9090)
  if [[ -z "${port}" ]]; then
    log_error "Prometheus port not found"
    log_info "Try starting with: ${0} start-with-metrics"
    exit 1
  fi
  open_url "http://localhost:${port}" "Prometheus"
}

# Tailnet peer routing ------------------------------------------------------

# Creates the state directory, owner only.
ensure_state_dir() {
  mkdir -p "${STATE_DIR}"
  chmod 700 "${STATE_DIR}"
}

# Resolves the Tailscale client from PATH, then from the macOS bundle.
resolve_tailscale_client() {
  local bundled="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

  if command -v tailscale >/dev/null 2>&1; then
    command -v tailscale
    return 0
  fi

  if [[ -x "${bundled}" ]]; then
    echo "${bundled}"
    return 0
  fi

  return 1
}

# Converts a duration such as 10m, 600s or 1h into seconds.
duration_seconds() {
  local number="${1%[smh]}" unit="${1##*[0-9]}"

  [[ "${number}" =~ ^[0-9]+$ ]] || { echo 0; return 0; }

  # Base 10 explicitly: bash reads a leading zero as octal, so 08m would fail.
  number=$((10#${number}))
  case "${unit}" in
    h) echo $((number * 3600)) ;;
    m) echo $((number * 60)) ;;
    *) echo "${number}" ;;
  esac
}

# Seconds between status refreshes: half the staleness tolerance, at least 60,
# so a missed run still leaves the document inside the tolerance.
status_refresh_interval() {
  local tolerance
  tolerance="$(duration_seconds "${HTTP_PROXY_TAILSCALE_STATUS_MAX_AGE:-10m}")"

  local interval=$((tolerance / 2))
  [[ "${interval}" -lt 60 ]] && interval=60
  echo "${interval}"
}

# Escapes the characters that would make a plist invalid XML.
xml_escape() {
  printf '%s' "${1}" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# Answers whether launchd currently holds the status agent.
status_agent_loaded() {
  launchctl print "gui/$(id -u)/${STATUS_AGENT_LABEL}" >/dev/null 2>&1
}

# Installs the launchd agent that keeps the status document fresh on macOS.
install_status_agent() {
  local tolerance interval
  tolerance="$(duration_seconds "${HTTP_PROXY_TAILSCALE_STATUS_MAX_AGE:-10m}")"
  interval="$(status_refresh_interval)"

  if [[ "${tolerance}" -lt 120 ]]; then
    log_warning "HTTP_PROXY_TAILSCALE_STATUS_MAX_AGE is ${tolerance}s, which no refresh interval can keep up with"
    log_info "Raise it to at least 2m, or refresh the document yourself"
    return 0
  fi

  if ! (PATH="${STATUS_AGENT_PATH}"; resolve_tailscale_client >/dev/null); then
    log_warning "Not installing the status refresh: the Tailscale client was not found"
    log_info "Looked in ${STATUS_AGENT_PATH} and in /Applications/Tailscale.app/Contents/MacOS/Tailscale"
    return 0
  fi

  ensure_state_dir
  mkdir -p "$(dirname "${STATUS_AGENT_PLIST}")"
  : >"${TAILSCALE_STATUS_LOG}"

  local program log agent_path
  program="$(xml_escape "${SCRIPT_DIR}/$(basename "${SOURCE}")")"
  log="$(xml_escape "${TAILSCALE_STATUS_LOG}")"

  agent_path="$(xml_escape "${STATUS_AGENT_PATH}")"

  cat >"${STATUS_AGENT_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${STATUS_AGENT_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${program}</string>
    <string>tailscale-status</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>${agent_path}</string>
  </dict>
  <key>StartInterval</key>
  <integer>${interval}</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>${log}</string>
</dict>
</plist>
EOF

  launchctl bootout "gui/$(id -u)/${STATUS_AGENT_LABEL}" >/dev/null 2>&1 || true

  # A label still loaded here belongs to the previous agent, and would answer
  # for the new one below.
  if status_agent_loaded; then
    log_warning "Could not unload the previous ${STATUS_AGENT_LABEL}; the refresh still runs the old one"
    return 0
  fi

  launchctl bootstrap "gui/$(id -u)" "${STATUS_AGENT_PLIST}" >/dev/null 2>&1 || true

  if ! status_agent_loaded; then
    log_warning "Could not load ${STATUS_AGENT_LABEL}; run it yourself with ${0} tailscale-status"
    return 0
  fi

  log_success "Status refresh installed, every ${interval}s"
}

# Removes the launchd agent.
remove_status_agent() {
  [[ -f "${STATUS_AGENT_PLIST}" ]] || return 0

  launchctl bootout "gui/$(id -u)/${STATUS_AGENT_LABEL}" >/dev/null 2>&1 || true

  # The plist stays while the agent does, so a later removal tries again.
  if status_agent_loaded; then
    log_warning "${STATUS_AGENT_LABEL} is still loaded; unload it with: launchctl bootout gui/$(id -u)/${STATUS_AGENT_LABEL}"
    return 0
  fi

  rm -f "${STATUS_AGENT_PLIST}"

  if [[ -e "${STATUS_AGENT_PLIST}" ]]; then
    log_warning "Could not delete ${STATUS_AGENT_PLIST}"
    return 0
  fi

  log_info "Status refresh removed"
}

# Runs a discovery cycle now instead of waiting for the next one.
tailscale_refresh_peers() {
  if [[ "${TAILSCALE_ENABLED}" != "true" ]]; then
    log_warning "Tailnet peer routing is disabled, so there is no cycle to run"
    echo "   Enable it with: ${0} start-with-tailscale" >&2
    return 1
  fi

  if ! is_running tailscale_peers; then
    log_warning "Tailnet peer routing is enabled but its service is not running"
    echo "   Start it with: ${0} start-with-tailscale" >&2
    echo "   Or stop expecting it with: ${0} stop-tailscale" >&2
    return 1
  fi

  resolve_tailscale_source

  # A cycle against a stale document misses a machine that came online since it was written.
  if [[ "${TAILSCALE_SOURCE}" == "file" ]] && ! write_tailscale_status; then
    log_error "Not forcing a cycle: the tailnet status document could not be refreshed"
    return 1
  fi

  local before timeout
  before="$(cat "${TAILSCALE_COMPLETED_FILE}" 2>/dev/null)"
  timeout="$(duration_seconds "${HTTP_PROXY_TAILSCALE_REFRESH_TIMEOUT:-30s}")"

  if ! dc_tailscale kill -s SIGHUP tailscale_peers >/dev/null 2>&1; then
    log_error "Could not signal the peer discovery service"
    echo "   Check it with: ${0} logs tailscale_peers" >&2
    return 1
  fi

  local waited current
  for ((waited = 0; waited < timeout; waited++)); do
    # The service writes this file last, so the report beside it is already the new one.
    current="$(cat "${TAILSCALE_COMPLETED_FILE}" 2>/dev/null)"
    if [[ -n "${current}" && "${current}" != "${before}" ]]; then
      # A cycle finishing between these two reads only substitutes a newer one.
      return 0
    fi
    sleep 1
  done

  log_error "The discovery cycle did not complete within ${timeout}s"
  echo "   The last recorded cycle is unchanged, so this is not a fresh result." >&2
  echo "   Check the service with: ${0} logs tailscale_peers" >&2
  return 1
}

# Installs or removes the agent according to the platform and the source.
apply_status_agent() {
  [[ "${OSTYPE}" == darwin* ]] || return 0

  if [[ "${TAILSCALE_ENABLED}" == "true" && "${TAILSCALE_SOURCE}" == "file" ]]; then
    install_status_agent
  else
    remove_status_agent
  fi
}

# Writes the tailnet status document the file source reads, through a rename.
write_tailscale_status() {
  local client temp

  if ! client="$(resolve_tailscale_client)"; then
    log_error "Tailscale command-line client not found"
    log_info "Looked on PATH and in /Applications/Tailscale.app/Contents/MacOS/Tailscale"
    return 1
  fi

  ensure_state_dir

  temp="$(mktemp "${STATE_DIR}/tailscale-status.json.XXXXXX")"
  if ! "${client}" status --json >"${temp}" 2>/dev/null; then
    rm -f "${temp}"
    log_error "Failed to read the tailnet status from ${client}"
    log_info "Check that Tailscale is running and connected"
    return 1
  fi

  chmod 600 "${temp}"
  mv "${temp}" "${TAILSCALE_STATUS_FILE}"
  log_success "Tailnet status written to ${TAILSCALE_STATUS_FILE}"
  summarise_tailscale_status "${TAILSCALE_STATUS_FILE}"
}

# Says what the document holds, because "written" is true even when the document
# is useless: a client that is running but logged out answers with an empty
# tailnet, the write succeeds, and peer discovery then finds nothing with no
# failure reported anywhere in the chain. A count makes that visible without
# probing anything or reading the client a second time.
#
# The counts come from the document itself, by counting keys. There is no jq or
# python3 dependency in this project and this is not the place to add one. POSIX
# character classes, because BSD grep does not take \s.
summarise_tailscale_status() {
  local document="$1" machines online state

  local online_keys
  machines="$(grep -cE '^[[:space:]]*"HostName":' "${document}" 2>/dev/null || true)"
  online="$(grep -cE '^[[:space:]]*"Online":[[:space:]]*true' "${document}" 2>/dev/null || true)"
  online_keys="$(grep -cE '^[[:space:]]*"Online":' "${document}" 2>/dev/null || true)"
  state="$(grep -m1 -oE '"BackendState":[[:space:]]*"[^"]*"' "${document}" 2>/dev/null | cut -d'"' -f4 || true)"

  # Every field has to have been found, not just one of them. Self is always a
  # machine with a state and an online flag, so a miss on any of the three means
  # the document is not shaped the way these counts read it, and a number from a
  # half-parsed document is worse than admitting the shape was not recognised.
  if [[ -z "${machines}" || "${machines}" -eq 0 ]] ||
    [[ -z "${online_keys}" || "${online_keys}" -eq 0 ]] ||
    [[ -z "${state}" ]]; then
    log_warning "The document was written but could not be summarised"
    return 0
  fi

  log_info "$(count_noun "${machines}" machine) in the document, ${online:-0} online, this machine ${state:-unknown}"

  # Only claims that can be read off the counts without knowing which machine
  # an online count belongs to. An online count of one is not necessarily this
  # machine: it is also one peer up while this machine is logged out.
  if [[ "${machines}" -le 1 ]]; then
    log_warning "The document holds only this machine, so nothing will be forwarded"
    log_info "Check that Tailscale is logged in and the other machines are on this account"
  elif [[ -n "${state}" && "${state}" != "Running" ]]; then
    log_warning "Tailscale on this machine is ${state}, so nothing will be forwarded"
    log_info "Bring it up with: tailscale up"
  fi
}

# Writes the status document when the source is the host-written file.
refresh_tailscale_status_if_needed() {
  if [[ "${TAILSCALE_ENABLED}" != "true" || "${TAILSCALE_SOURCE}" != "file" ]]; then
    return 0
  fi

  log_info "Writing the tailnet status document for peer discovery..."
  write_tailscale_status || log_warning "Peer discovery will report the status document as missing"
}

# Starts the proxy with peer routing on.
start_with_tailscale() {
    TAILSCALE_ENABLED=true
    record_stack tailscale
    apply_optional_stacks
    ensure_state_dir
    refresh_tailscale_status_if_needed
    apply_status_agent
    recreate_stack
}

# Stops peer routing alone and removes every forwarded hostname.
stop_tailscale() {
    log_info "Stopping tailnet peer routing..."
    clear_stack tailscale
    TAILSCALE_ENABLED=false
    apply_status_agent
    dc_tailscale stop tailscale_peers >/dev/null 2>&1 || true
    dc_tailscale rm -f tailscale_peers >/dev/null 2>&1 || true

    if is_running http-proxy; then
        dc_cmd exec -T traefik sh -c 'rm -f /traefik/dynamic/tailscale-peer-*.yaml' >/dev/null 2>&1 || true
    fi

    log_success "Peer routing stopped, the proxy keeps serving its own containers"
    log_info "No hostname is forwarded to another machine until it is started again"
}

# Prints the report the service wrote for its most recent discovery cycle.
show_tailscale_peers() {
  local as_json="${1:-false}"

  if [[ "${TAILSCALE_ENABLED}" != "true" ]]; then
    log_warning "Tailnet peer routing is disabled"
    echo ""
    echo "Enable it with:"
    echo "  ${0} start-with-tailscale"
    echo ""
    echo "On a platform whose Tailscale daemon exposes no socket, such as macOS, add:"
    echo "  HTTP_PROXY_TAILSCALE_SOURCE=file"
    return 0
  fi

  if ! is_running tailscale_peers; then
    log_warning "Tailnet peer routing is enabled but its service is not running"
    echo "   Start it with: ${0} start-with-tailscale"
    echo "   Or stop expecting it with: ${0} stop-tailscale"
    return 0
  fi

  local report="${TAILSCALE_RENDERED_FILE}"
  [[ "${as_json}" == "true" ]] && report="${TAILSCALE_STATE_FILE}"

  if [[ ! -f "${report}" ]]; then
    log_warning "No discovery cycle has been recorded yet"
    echo "  Expected: ${report}"
    if ! is_running http-proxy; then
      echo "  The proxy is not running. Start it with: ${0} start"
    else
      echo "  Peer discovery writes it once per cycle; give it a moment and try again."
    fi
    return 0
  fi

  if ! is_running http-proxy; then
    log_warning "The proxy is not running, so this is the last recorded cycle and not the current state"
    echo ""
  elif [[ -n "$(find "${report}" -mmin +1 2>/dev/null)" ]]; then
    # The proxy is up and discovery has not written in a while.
    log_warning "This report is more than a minute old, so discovery may have stopped"
    echo "   Check the service with: ${0} logs tailscale_peers"
    [[ -s "${TAILSCALE_STATUS_LOG}" ]] && echo "   The status refresh reported errors in ${TAILSCALE_STATUS_LOG}"
    echo ""
  fi

  cat "${report}"
}

# Prints one summary line for the status command.
show_tailscale_summary() {
  if [[ "${TAILSCALE_ENABLED}" != "true" ]]; then
    return 0
  fi

  echo ""
  if [[ ! -f "${TAILSCALE_SUMMARY_FILE}" ]]; then
    # Not log_warning: status is one report, and this is a state of the system
    # rather than a diagnostic about the CLI, so it belongs on stdout.
    echo "⚠️  Tailnet peer routing is enabled, but there is no usable discovery record"
    echo "   💡 Detail: ${0} tailscale-peers"
    return 0
  fi

  local summary state counts seen probed extra
  # One snapshot: the writer replaces this file by rename, so reading it more
  # than once can pair one cycle's counts with another cycle's machines. And
  # read returns non-zero at end of file, which under errexit would otherwise
  # end the whole command on an empty or truncated record.
  if ! summary="$(cat -- "${TAILSCALE_SUMMARY_FILE}")" ||
    ! { read -r state && read -r counts; } <<<"${summary}"; then
    echo "⚠️  Tailnet peer routing is enabled, but there is no usable discovery record"
    echo "   💡 Detail: ${0} tailscale-peers"
    return 0
  fi
  read -r seen probed extra <<<"${counts}"

  # A shape this CLI does not know is not a summary: read leaves the missing
  # fields empty rather than failing, so the counts would shift a column.
  if [[ "${state}" != "ok" && "${state}" != "aborted" ]] || [[ -n "${extra}" ]] ||
    ! [[ "${seen}" =~ ^(0|[1-9][0-9]*)$ && "${probed}" =~ ^(0|[1-9][0-9]*)$ ]]; then
    echo "⚠️  Tailnet peer routing is enabled, but there is no usable discovery record"
    echo "   💡 Detail: ${0} tailscale-peers"
    return 0
  fi

  if [[ "${state}" == "aborted" ]]; then
    echo "⚠️  Tailnet peer routing: the last cycle could not read the local routing table"
    echo "   The routes from the previous cycle are still in place, and this clears within seconds of a restart."
    echo "   💡 Detail: ${0} tailscale-peers"
    return 0
  fi

  # How many machines forward, and how many hostnames they carry, is the rows
  # counted. The record does not state it twice, so it cannot disagree.
  local forwarding=0 hostnames=0 commas name hosts trailing
  while IFS=$'\t' read -r name hosts trailing; do
    [[ -z "${name}" ]] && continue
    # A row is a name, one tab, and its hostnames. Anything else would have
    # counted a machine or a hostname the service never wrote.
    if [[ -z "${hosts}" || -n "${trailing}" ]]; then
      echo "⚠️  Tailnet peer routing is enabled, but there is no usable discovery record"
      echo "   💡 Detail: ${0} tailscale-peers"
      return 0
    fi
    forwarding=$((forwarding + 1))
    commas="${hosts//[^,]/}"
    hostnames=$((hostnames + ${#commas} + 1))
  done < <(tail -n +3 <<<"${summary}")

  if [[ "${forwarding}" == "0" ]]; then
    # Says nothing about the machines that were never contacted.
    log_success "Tailnet peer routing: nothing forwarded, $(count_noun "${seen:-0}" machine) seen and ${probed:-0} probed, none of which runs this proxy"
    echo "   💡 Detail: ${0} tailscale-peers"
    return 0
  fi

  log_success "Tailnet peer routing: $(count_noun "${forwarding}" machine) forwarding $(count_noun "${hostnames}" hostname)"
  # The column is sized from the names present: the longest on a real tailnet
  # is longer than any width chosen in advance.
  local name hosts width=0 example=""
  while IFS=$'\t' read -r name _; do
    [[ "${#name}" -gt "${width}" ]] && width="${#name}"
  done < <(tail -n +3 <<<"${summary}")

  while IFS=$'\t' read -r name hosts; do
    [[ -z "${name}" ]] && continue
    printf "     %-${width}s  %s\n" "${name}" "${hosts//,/, }"
    [[ -z "${example}" ]] && example="${hosts%%,*}"
  done < <(tail -n +3 <<<"${summary}")

  # TLS terminates here, so each of these needs a certificate on this machine.
  # Whether one exists is not checked. The example is a hostname listed just
  # above, so the command works when it is copied.
  echo "   Over HTTPS each needs a certificate here, for example:"
  echo "     ${0} generate-mkcert '${example}'"
  echo "   💡 Detail: ${0} tailscale-peers"
}

# Renders a count with its noun, singular or plural.
count_noun() {
  local count="$1" noun="$2"
  if [[ "${count}" == "1" ]]; then
    echo "${count} ${noun}"
  else
    echo "${count} ${noun}s"
  fi
}

# Docker Compose helpers
dc_cmd() { docker compose "${COMPOSE_FILES[@]}" "$@"; }
# Addresses every optional stack, whatever is recorded. A --profile flag
# replaces COMPOSE_PROFILES rather than adding to it, so a teardown names them.
dc_all() { docker compose "${COMPOSE_FILES[@]}" --profile metrics --profile tailscale "$@"; }
dc_tailscale() { docker compose "${COMPOSE_FILES[@]}" --profile tailscale "$@"; }

# Check if service is running
is_running() { dc_cmd ps | grep -q "$1"; }

# Poll a URL through the proxy until it returns HTTP 200 or attempts run out.
# Uses --resolve so both the connection target and the TLS SNI match the test
# host, exercising the real routing path. Echoes the last status code seen.
self_test_http_probe() {
  local scheme="$1" host="$2" port="$3" extra="$4" path="${5:-}"
  local code=""

  for _ in $(seq 1 15); do
    code="$(curl ${extra} -s -o /dev/null -w '%{http_code}' \
      --resolve "${host}:${port}:127.0.0.1" --max-time 5 \
      "${scheme}://${host}${path}" 2>/dev/null || true)"
    if [[ "${code}" == "200" ]]; then
      echo "200"
      return 0
    fi
    sleep 2
  done

  # Always succeeds, for the same reason as the body probe below: a non-zero
  # return inside the caller's command substitution would abort the self-test
  # under set -e instead of letting it report which check failed.
  echo "${code}"
}

# Poll a URL until it returns the expected body, or attempts run out.
#
# A mounted path cannot be checked by status code alone. When its route is
# missing, the request falls through to whatever serves the hostname, which
# answers 200 from the wrong container, so a status probe passes on a machine
# where VIRTUAL_PATH is broken. Comparing the body is what makes the check
# meaningful. Echoes the last body seen.
self_test_body_probe() {
  local scheme="$1" host="$2" port="$3" extra="$4" path="$5" expected="$6"
  local body=""

  for _ in $(seq 1 15); do
    # -L because a backend serving a directory answers the bare path with a
    # redirect to the trailing-slash form, and that redirect page looks the
    # same whichever container produced it.
    body="$(curl ${extra} -s -L \
      --resolve "${host}:${port}:127.0.0.1" --max-time 5 \
      "${scheme}://${host}${path}" 2>/dev/null || true)"
    if [[ "${body}" == *"${expected}"* ]]; then
      echo "${expected}"
      return 0
    fi
    sleep 2
  done

  # Always succeeds: the caller assigns this in a command substitution, and
  # under set -e a non-zero return there would abort the whole self-test before
  # it could report the failure or clean up its containers.
  echo "${body}"
}

# Self-test: end-to-end check that the proxy actually routes a container.
run_self_test() {
  local first_tld test_domain container_name dns_port target_ip
  local resolved http_code https_code failures=0
  local path_container_name path_body https_path_body
  local path_marker="spark-http-proxy path routing works"

  first_tld="${HTTP_PROXY_DNS_TLDS:-loc}"
  first_tld="$(echo "${first_tld%%,*}" | tr -d '[:space:]')"
  test_domain="spark-http-proxy-selftest.${first_tld}"
  container_name="spark-proxy-self-test"
  path_container_name="spark-proxy-self-test-path"
  dns_port="${HTTP_PROXY_DNS_PORT:-19322}"
  target_ip="${HTTP_PROXY_DNS_TARGET_IP:-127.0.0.1}"

  log_info "Running self-test (domain: ${test_domain})..."

  # 1. Proxy and DNS services must be up
  if ! is_running http-proxy; then
    log_error "HTTP Proxy is not running. Start it first with: ${0} start"
    return 1
  fi
  if ! is_running dns; then
    log_error "DNS service is not running. Start the proxy first with: ${0} start"
    return 1
  fi
  log_success "Proxy and DNS services are running"

  # Always remove the test containers when the function returns
  trap 'docker rm -f "'"${container_name}"'" "'"${path_container_name}"'" >/dev/null 2>&1 || true' RETURN

  # 2. Start a throwaway backend opted into the proxy via VIRTUAL_HOST
  log_info "Starting test container with VIRTUAL_HOST=${test_domain}..."
  docker rm -f "${container_name}" >/dev/null 2>&1 || true
  if ! docker run -d --name "${container_name}" -e "VIRTUAL_HOST=${test_domain}" nginx:latest >/dev/null 2>&1; then
    log_error "Failed to start test container"
    return 1
  fi

  # A second backend on the same hostname, mounted under a path. It serves a
  # marker the host's container does not, which is what distinguishes a working
  # path route from a request falling through to the host.
  log_info "Starting test container with VIRTUAL_PATH=/self-test on the same host..."
  docker rm -f "${path_container_name}" >/dev/null 2>&1 || true
  if ! docker run -d --name "${path_container_name}" \
    -e "VIRTUAL_HOST=${test_domain}" -e "VIRTUAL_PATH=/self-test" \
    -e "MARKER=${path_marker}" \
    nginx:latest sh -c 'mkdir -p /usr/share/nginx/html/self-test && printf "%s" "${MARKER}" > /usr/share/nginx/html/self-test/index.html && exec nginx -g "daemon off;"' >/dev/null 2>&1; then
    log_error "Failed to start path test container"
    return 1
  fi

  # 3. DNS must resolve the test domain to the configured target IP
  log_info "Testing DNS resolution..."
  resolved="$(dig @127.0.0.1 -p "${dns_port}" "${test_domain}" +short 2>/dev/null | head -n1)"
  if [[ "${resolved}" == "${target_ip}" ]]; then
    log_success "DNS resolves ${test_domain} → ${resolved}"
  else
    log_error "DNS resolution failed (got '${resolved:-<empty>}', expected ${target_ip})"
    failures=$((failures + 1))
  fi

  # 4. The proxy must route the test domain over HTTP
  log_info "Testing HTTP routing (this can take a few seconds to propagate)..."
  http_code="$(self_test_http_probe http "${test_domain}" 80 "")"
  if [[ "${http_code}" == "200" ]]; then
    log_success "HTTP route works (200)"
  else
    log_error "HTTP route failed (last status: ${http_code:-none})"
    failures=$((failures + 1))
  fi

  # 5. The proxy must route the test domain over HTTPS (self-signed is fine)
  log_info "Testing HTTPS routing..."
  https_code="$(self_test_http_probe https "${test_domain}" 443 "-k")"
  if [[ "${https_code}" == "200" ]]; then
    log_success "HTTPS route works (200)"
  else
    log_error "HTTPS route failed (last status: ${https_code:-none})"
    failures=$((failures + 1))
  fi

  # 6. A container mounted under a path must answer that path itself. Checked by
  # body, not status: without the path route the request reaches the host's
  # container, which answers 200 and would hide the failure.
  log_info "Testing VIRTUAL_PATH routing..."
  path_body="$(self_test_body_probe http "${test_domain}" 80 "" "/self-test" "${path_marker}")"
  if [[ "${path_body}" == "${path_marker}" ]]; then
    log_success "Path route works (/self-test answered by the mounted container)"
  else
    log_error "Path route failed (/self-test was not answered by the mounted container)"
    failures=$((failures + 1))
  fi

  # 7. The same over HTTPS, so the two schemes cannot diverge unnoticed
  log_info "Testing VIRTUAL_PATH routing over HTTPS..."
  https_path_body="$(self_test_body_probe https "${test_domain}" 443 "-k" "/self-test/" "${path_marker}")"
  if [[ "${https_path_body}" == "${path_marker}" ]]; then
    log_success "Path route works over HTTPS"
  else
    log_error "Path route over HTTPS failed"
    failures=$((failures + 1))
  fi

  if [[ ${failures} -eq 0 ]]; then
    log_success "Self-test completed successfully"
    return 0
  fi

  log_error "Self-test failed (${failures} check(s) failed)"
  return 1
}

# Ensure proxy is running before proceeding
ensure_running() {
  if ! is_running http-proxy; then
    log_warning "HTTP Proxy is not running"
    echo "   🚀 Start with: ${0} start"
    exit 1
  fi
}

# Clean up and start services
recreate_stack() {

  docker rm -vf http-proxy >/dev/null 2>&1 || true
  docker rm -vf "$(docker ps -q --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME}")" >/dev/null 2>&1 || true

  dc_all down -v
  dc_cmd up -d --pull always
}

# Pull latest images and recreate only changed containers (preserves volumes)
upgrade_stack() {
  log_info "Pulling latest images..."
  dc_cmd pull

  log_info "Recreating containers with updated images..."
  dc_cmd up -d
}

# Self-update the script and compose files from the git repository
self_update() {
  local repo_dir
  repo_dir="$(git -C "${SCRIPT_DIR}" rev-parse --show-toplevel 2>/dev/null)" || {
    log_error "Not a git repository. Self-update requires a git-based installation."
    log_info "Re-run the installer: https://github.com/sparkfabrik/http-proxy#installation"
    exit 1
  }

  # Abort if there are local modifications
  if [[ -n "$(git -C "${repo_dir}" status --porcelain 2>/dev/null)" ]]; then
    log_error "Local changes detected in: ${repo_dir}"
    log_warning "Aborting to avoid overwriting local modifications."
    log_info "Commit or stash your changes, then retry."
    exit 1
  fi

  local current_branch current_commit upstream head after
  current_branch=$(git -C "${repo_dir}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
  current_commit=$(git -C "${repo_dir}" rev-parse --short HEAD 2>/dev/null || echo "unknown")

  upstream="$(git -C "${repo_dir}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  if [[ -z "${upstream}" ]]; then
    log_error "Branch '${current_branch}' tracks no remote branch, so there is nothing to update from"
    log_info "Set one with: git -C ${repo_dir} branch --set-upstream-to=origin/${current_branch}"
    exit 1
  fi

  log_info "Checking for updates on branch '${current_branch}' (currently at ${current_commit})..."
  if ! git -C "${repo_dir}" fetch --quiet; then
    log_error "Could not reach the remote to check for updates"
    exit 1
  fi

  head="$(git -C "${repo_dir}" rev-parse HEAD)"
  after="$(git -C "${repo_dir}" rev-parse '@{upstream}')"

  if [[ "${head}" == "${after}" ]]; then
    log_success "Already up to date (${current_commit})"
    return 0
  fi

  if ! git -C "${repo_dir}" merge-base --is-ancestor "${head}" "${after}"; then
    log_warning "${upstream} is not a descendant of ${current_commit}, so the commit moves backwards"
    log_info "Files git does not track, such as built binaries, may be discarded"
  fi

  # Matches the remote exactly, whether it moved on or was rewritten.
  if ! git -C "${repo_dir}" reset --hard "${after}" >/dev/null; then
    log_error "Could not match ${upstream}"
    exit 1
  fi

  local new_commit
  new_commit=$(git -C "${repo_dir}" rev-parse --short HEAD 2>/dev/null || echo "unknown")

  if [[ "${current_commit}" == "${new_commit}" ]]; then
    log_success "Already up to date (${new_commit})"
  else
    log_success "Updated: ${current_commit} → ${new_commit}"
    log_info "Applying the update..."
    # The pull has just rewritten this file, and bash reads a script by byte
    # offset as it runs, so continuing here would run a mix of the old and the
    # new one. exec replaces the process with the updated script.
    exec "${SCRIPT_PATH}" upgrade
  fi
}

# The revision an image was built from. Published images carry it as an OCI
# label, written by the release pipeline, and reading the label works whether the
# container is running or stopped. The file the Dockerfiles write is the
# fallback: it only holds a revision when the build was given GIT_VERSION, which
# happens through the Makefile and not through compose, so a pulled image has
# the label and a locally built one usually has neither.
container_revision() {
  local container="$1" revision=""

  revision="$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' "${container}" 2>/dev/null || true)"
  if [[ -n "${revision}" && "${revision}" != "<no value>" ]]; then
    echo "${revision:0:7}"
    return 0
  fi

  revision="$(docker exec "${container}" cat /.version 2>/dev/null || true)"
  if [[ -n "${revision}" && "${revision}" != "unknown" ]]; then
    echo "${revision}"
    return 0
  fi

  echo "unknown"
}

show_version() {
  echo "spark-http-proxy version information:"
  echo ""

  # Get local git version
  local local_git_version=""
  if git -C "${SCRIPT_DIR}" rev-parse --git-dir >/dev/null 2>&1; then
    local_git_version=$(git -C "${SCRIPT_DIR}" rev-parse --short HEAD 2>/dev/null || echo "unknown")
    # Check for uncommitted changes
    if [[ -n "$(git -C "${SCRIPT_DIR}" status --porcelain 2>/dev/null)" ]]; then
      local_git_version="${local_git_version}-dirty"
    fi
    echo "  Local git version: ${local_git_version}"
  else
    echo "  Local git version: unknown (not in git repository)"
    local_git_version="unknown"
  fi

  echo ""
  echo "Container versions:"
  echo "-------------------"

  # Define containers to check
  local containers=("http-proxy:traefik" "http-proxy-dinghy_layer-1:dinghy_layer" "http-proxy-join_networks-1:join_networks" "http-proxy-dns-1:dns")
  local version_mismatch=false

  for container_info in "${containers[@]}"; do
    local container_name="${container_info%%:*}"
    local service_name="${container_info##*:}"

    # Check if container exists and get its git version
    if docker ps -a --format "{{.Names}}" | grep -q "^${container_name}$"; then
      local container_git_version
      container_git_version="$(container_revision "${container_name}")"

      # Check if container is running
      if docker ps --format "{{.Names}}" | grep -q "^${container_name}$"; then
        echo "  ${service_name}: ${container_git_version} (running)"
      else
        echo "  ${service_name}: ${container_git_version} (stopped)"
      fi

      # Check for version mismatch
      if [[ "${local_git_version}" != "unknown" && "${container_git_version}" != "unknown" && "${local_git_version}" != "${container_git_version}" ]]; then
        version_mismatch=true
      fi
    else
      echo "  ${service_name}: not built"
    fi
  done

  echo ""
  echo "Traefik version information:"
  echo "----------------------------"

  # Get Traefik version if container is running
  if docker ps --format "{{.Names}}" | grep -q "^http-proxy$"; then
    docker exec http-proxy traefik version 2>/dev/null || {
      echo "  Failed to get Traefik version from running container"
    }
  else
    echo "  Traefik container is not running"
  fi

  # Warn about version mismatches
  if [[ "${version_mismatch}" == "true" ]]; then
    echo ""
    echo "⚠️  Warning: Local git version differs from container versions."
    echo "   Consider running '${0} start' to rebuild with latest changes."
  fi
}

# Runs once the Docker helpers exist and only where Docker answers.
if docker info >/dev/null 2>&1; then
  adopt_running_stacks
fi

case "$1" in
"" | "-h" | "--help")
  show_usage
  exit 0
  ;;
"help")
  show_detailed_help
  exit 0
  ;;
version)
  show_version
  exit 0
  ;;
show-config)
  show_config
  exit 0
  ;;
tailscale-refresh-peers)
  log_error "tailscale-refresh-peers was replaced by: ${0} tailscale-peers --refresh"
  exit 1
  ;;
hosts)
  hosts_command "${@:2}"
  exit $?
  ;;
tailscale-peers)
  peers_json=false
  peers_refresh=false
  for peers_arg in "${@:2}"; do
    case "${peers_arg}" in
    --json) peers_json=true ;;
    --refresh) peers_refresh=true ;;
    *)
      log_error "Unknown option: ${peers_arg}"
      log_info "Usage: ${0} tailscale-peers [--refresh] [--json]"
      exit 1
      ;;
    esac
  done
  if [[ "${peers_refresh}" == "true" ]]; then
    tailscale_refresh_peers || exit 1
  fi
  show_tailscale_peers "${peers_json}"
  exit 0
  ;;
tailscale-status)
  write_tailscale_status
  exit $?
  ;;
self-test)
  run_self_test
  exit $?
  ;;
status)
  log_info "HTTP Proxy Status"
  echo "=================================="

  if is_running http-proxy; then
    log_success "HTTP Proxy is running"
    dashboard_port=$(get_service_port traefik 8080)
    echo "   🌐 Traefik Dashboard: http://localhost:${dashboard_port:-'not available'}"
    echo ""
    dc_cmd ps
    echo ""

    if [[ "${METRICS_ENABLED}" != "true" ]]; then
      log_warning "Monitoring is not enabled"
      echo "   💡 Start with: ${0} start-with-metrics"
    elif is_running prometheus; then
      log_success "Monitoring services are running"
      grafana_port=$(get_service_port grafana 3000)
      prometheus_port=$(get_service_port prometheus 9090)
      echo "   📊 Grafana: http://localhost:${grafana_port:-'not available'} (admin/admin)"
      echo "   📈 Prometheus: http://localhost:${prometheus_port:-'not available'}"
    else
      log_warning "Monitoring is enabled but its services are not running"
      echo "   💡 Start them with: ${0} start-with-metrics"
    fi

    if [[ "${TAILSCALE_ENABLED}" == "true" ]]; then
      show_tailscale_summary
    else
      echo ""
      log_warning "Tailnet peer routing is not running"
      echo "   💡 Start with: ${0} start-with-tailscale"
    fi
  else
    log_warning "HTTP Proxy is not running"
    echo "   🚀 Start with: ${0} start"
  fi
  ;;
start)
  log_info "Starting HTTP Proxy (basic stack)..."
  ensure_state_dir
  refresh_tailscale_status_if_needed
  recreate_stack
  echo ""
  log_success "HTTP Proxy running"
  dashboard_port=$(get_service_port traefik 8080)
  echo " 🌐 Traefik Dashboard: http://localhost:${dashboard_port:-'not available'}"
  echo " 🕸️  DNS resolving domains: *.${HTTP_PROXY_DNS_TLDS:-loc} → ${HTTP_PROXY_DNS_TARGET_IP:-127.0.0.1}"
  echo " 💡 To add monitoring: ${0} start-with-metrics"
  show_dns_env_vars
  configure_system_dns
  ;;
restart)
  ensure_state_dir
  refresh_tailscale_status_if_needed
  if ! is_running http-proxy; then
    log_info "HTTP Proxy is not running, starting it..."
    recreate_stack
    log_success "HTTP Proxy started"
  else
    log_info "Restarting HTTP Proxy..."
    dc_cmd restart
    log_success "HTTP Proxy restarted"
  fi
  ;;
start-with-tailscale)
  log_info "Starting HTTP Proxy with tailnet peer routing..."
  start_with_tailscale
  echo ""
  log_success "HTTP Proxy running with peer routing"
  dashboard_port=$(get_service_port traefik 8080)
  echo "   🌐 Traefik Dashboard: http://localhost:${dashboard_port:-'not available'}"
  echo "   🕸️  Peer routing source: ${TAILSCALE_SOURCE}"
  echo "   💡 See what was found: ${0} tailscale-peers"
  show_dns_env_vars
  configure_system_dns
  ;;
stop-tailscale)
  stop_tailscale
  ;;
start-with-metrics)
  log_info "Starting HTTP Proxy with monitoring..."
  record_stack metrics
  METRICS_ENABLED=true
  apply_optional_stacks
  ensure_state_dir
  refresh_tailscale_status_if_needed
  recreate_stack
  echo ""
  log_success "HTTP Proxy + Monitoring running"
  dashboard_port=$(get_service_port traefik 8080)
  grafana_port=$(get_service_port grafana 3000)
  prometheus_port=$(get_service_port prometheus 9090)
  echo "   🌐 Traefik Dashboard: http://localhost:${dashboard_port:-'not available'}"
  echo "   🔍 DNS resolving domains: *.${HTTP_PROXY_DNS_TLDS:-loc} → ${HTTP_PROXY_DNS_TARGET_IP:-127.0.0.1}"
  echo "   📊 Grafana Dashboard: http://localhost:${grafana_port:-'not available'} (admin/admin)"
  echo "   📈 Prometheus: http://localhost:${prometheus_port:-'not available'}"
  show_dns_env_vars
  configure_system_dns
  ;;
stop-metrics)
  clear_stack metrics
  METRICS_ENABLED=false
  log_info "Stopping monitoring services..."
  dc_cmd stop prometheus grafana
  dc_cmd rm -f prometheus grafana
  log_success "Monitoring stopped (HTTP Proxy still running)"
  ;;
clean)
  log_info "Stopping all services and cleaning volumes..."
  remove_status_agent
  dc_all down -v
  log_success "All services stopped and volumes removed"
  ;;
destroy)
  log_warning "This will completely remove all containers, volumes, networks, and images"
  if [ ! -t 0 ]; then
    log_error "Cannot confirm without a terminal, so nothing was destroyed"
    log_info "Re-run this interactively to confirm"
    exit 1
  fi

  read -p "Are you sure? (y/N): " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    log_info "Destroying all HTTP proxy resources..."
    remove_status_agent
    dc_all down --volumes --rmi all --remove-orphans
    log_success "All HTTP proxy resources destroyed"
  else
    log_info "Destroy cancelled"
  fi
  ;;
logs)
  if [[ -n "${2:-}" ]]; then
    log_info "Showing logs for service: ${2}"
    dc_cmd logs -f "${2}"
  else
    log_info "Showing logs for all services"
    dc_cmd logs -f
  fi
  ;;
configure-dns)
  configure_system_dns
  ;;
dashboard) open_dashboard ;;
grafana) open_grafana ;;
prometheus) open_prometheus ;;
completion) generate_completion ;;
install-completion) install_completion ;;
generate-mkcert) generate_mkcert "${2}" ;;
list-certs) list_certs ;;
remove-cert) remove_cert "${@:2}" ;;
upgrade)
  ensure_state_dir
  ensure_running
  log_info "Upgrading HTTP Proxy images..."
  upgrade_stack
  echo ""
  log_success "Upgrade complete"
  show_version
  ;;
self-update)
  self_update
  ;;
*) dc_cmd "$@" ;;
esac
