#!/usr/bin/env bash

set -e

# Get the real path of the script.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
SCRIPT_PATH="${SCRIPT_DIR}/$(basename "${SOURCE}")"

# Libraries live beside the script; install.sh only ever symlinks, so a checkout
# is always complete. A missing one is a broken checkout, not a missing command.
if [[ ! -r "${SCRIPT_DIR}/lib/hosts.sh" ]]; then
  echo "❌ Missing ${SCRIPT_DIR}/lib/hosts.sh, so this checkout is incomplete" >&2
  echo "ℹ  Repair it with: ${SCRIPT_DIR}/spark-http-proxy self-update" >&2
  exit 1
fi
# shellcheck source=bin/lib/hosts.sh
. "${SCRIPT_DIR}/lib/hosts.sh"

# Paths
CONFIG_DIR="${HOME}/.local/spark/http-proxy"
CERT_DIR="${CONFIG_DIR}/certs"

# Function to discover compose file in priority order
discover_compose_file() {
  local candidates=(
    "${CONFIG_DIR}/compose.yml"
    "${SCRIPT_DIR}/compose.yml"
  )

  for candidate in "${candidates[@]}"; do
    if [[ -f "${candidate}" ]]; then
      echo "${candidate}"
      return 0
    fi
  done

  # Fallback if nothing found (shouldn't happen with ${SCRIPT_DIR}/compose.yml)
  echo "${SCRIPT_DIR}/compose.yml"
}

# Logging functions
log_info() { echo "ℹ  $1"; }
log_success() { echo "✅ $1"; }
log_error() { echo "❌ $1" >&2; }
log_warning() { echo "⚠️  $1" >&2; }

# Configuration
export COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-http-proxy}
export COMPOSE_FILE=${COMPOSE_FILE:-$(discover_compose_file)}

# Optional stacks, recorded so every command and every shell agrees.
OPTIONAL_STACKS_FILE="${CONFIG_DIR}/optional-stacks"

# Reports whether an optional stack is recorded as on.
stack_recorded() {
  grep -qx "${1}=true" "${OPTIONAL_STACKS_FILE}" 2>/dev/null
}

# Records an optional stack as on.
record_stack() {
  mkdir -p "${CONFIG_DIR}"
  clear_stack "$1"
  printf '%s=true\n' "$1" >>"${OPTIONAL_STACKS_FILE}"
}

# Removes an optional stack from the record, keeping every line boundary.
clear_stack() {
  [[ -f "${OPTIONAL_STACKS_FILE}" ]] || return 0

  local temp status=0
  temp="$(mktemp "${OPTIONAL_STACKS_FILE}.XXXXXX")"
  grep -vx "${1}=true" "${OPTIONAL_STACKS_FILE}" >"${temp}" || status=$?

  # grep exits 1 when nothing matched and 2 when it failed, so a record it
  # could not read is left as it is.
  if [[ "${status}" -gt 1 ]]; then
    rm -f "${temp}"
    log_warning "Could not read ${OPTIONAL_STACKS_FILE}, leaving it unchanged"
    return "${status}"
  fi

  if [[ -s "${temp}" ]]; then
    mv "${temp}" "${OPTIONAL_STACKS_FILE}"
  else
    rm -f "${temp}" "${OPTIONAL_STACKS_FILE}"
  fi
}

# Resolves an optional stack: an explicit variable, then the record, then off.
resolve_stack() {
  local name="$1" override="$2"

  if [[ -n "${override}" ]]; then
    echo "${override}"
    return 0
  fi
  if stack_recorded "${name}"; then
    echo "true"
    return 0
  fi
  echo "false"
}

# Names where a resolved state came from.
stack_origin() {
  local name="$1" override="$2"

  if [[ -n "${override}" ]]; then
    echo "the environment"
  elif stack_recorded "${name}"; then
    echo "${OPTIONAL_STACKS_FILE}"
  else
    echo "the default"
  fi
}

TAILSCALE_ENABLED="$(resolve_stack tailscale "${HTTP_PROXY_TAILSCALE_ENABLED:-}")"
TAILSCALE_ENABLED_ORIGIN="$(stack_origin tailscale "${HTTP_PROXY_TAILSCALE_ENABLED:-}")"
METRICS_ENABLED="$(resolve_stack metrics "${HTTP_PROXY_METRICS_ENABLED:-}")"
METRICS_ENABLED_ORIGIN="$(stack_origin metrics "${HTTP_PROXY_METRICS_ENABLED:-}")"

TAILSCALE_SOCKET="${HTTP_PROXY_TAILSCALE_SOCKET:-/var/run/tailscale/tailscaled.sock}"

# Sets the source from the host: the daemon socket if it is there, the
# host-written document if it is not. An explicit setting overrides both.
# Assigns rather than echoes, so the origin survives.
resolve_tailscale_source() {
  if [[ -n "${HTTP_PROXY_TAILSCALE_SOURCE:-}" ]]; then
    TAILSCALE_SOURCE="${HTTP_PROXY_TAILSCALE_SOURCE}"
    TAILSCALE_SOURCE_ORIGIN="the environment"
  elif [[ -S "${TAILSCALE_SOCKET}" ]]; then
    TAILSCALE_SOURCE="socket"
    TAILSCALE_SOURCE_ORIGIN="the daemon socket at ${TAILSCALE_SOCKET}"
  else
    TAILSCALE_SOURCE="file"
    TAILSCALE_SOURCE_ORIGIN="no daemon socket at ${TAILSCALE_SOCKET}"
  fi
}

TAILSCALE_SOURCE=""
TAILSCALE_SOURCE_ORIGIN=""
resolve_tailscale_source
STATE_DIR="${CONFIG_DIR}/state"
TAILSCALE_STATUS_FILE="${STATE_DIR}/tailscale-status.json"
TAILSCALE_STATE_FILE="${STATE_DIR}/tailscale-peers.json"
TAILSCALE_RENDERED_FILE="${STATE_DIR}/tailscale-peers.txt"
TAILSCALE_COMPLETED_FILE="${STATE_DIR}/tailscale-peers-completed-at"
TAILSCALE_SUMMARY_FILE="${STATE_DIR}/tailscale-peers-summary"
# Read by bin/lib/hosts.sh, which shellcheck follows only with -x.
# shellcheck disable=SC2034
HOSTS_STATE_FILE="${STATE_DIR}/hosts.tsv"
# shellcheck disable=SC2034
HOSTS_JSON_FILE="${STATE_DIR}/hosts.json"
TAILSCALE_SOCKET_OVERRIDE="$(dirname "${COMPOSE_FILE}")/compose.tailscale-socket.yml"
TAILSCALE_STATUS_LOG="${STATE_DIR}/tailscale-status.log"
STATUS_AGENT_LABEL="com.sparkfabrik.http-proxy.tailscale-status"
STATUS_AGENT_PLIST="${HOME}/Library/LaunchAgents/${STATUS_AGENT_LABEL}.plist"
STATUS_AGENT_PATH="${HTTP_PROXY_TAILSCALE_AGENT_PATH:-/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin}"

# Extra compose files. COMPOSE_FILE holds a single path.
COMPOSE_FILES=("-f" "${COMPOSE_FILE}")

# Adds the profiles and files the recorded stacks need.
apply_optional_stacks() {
  COMPOSE_FILES=("-f" "${COMPOSE_FILE}")
  local profiles=""

  if [[ "${METRICS_ENABLED}" == "true" ]]; then
    profiles="metrics"
  fi

  if [[ "${TAILSCALE_ENABLED}" == "true" ]]; then
    export HTTP_PROXY_TAILSCALE_ENABLED=true
    export HTTP_PROXY_TAILSCALE_SOURCE="${TAILSCALE_SOURCE}"
    profiles="${profiles:+${profiles},}tailscale"

    # Adds the socket mount, which lives in its own file.
    if [[ "${TAILSCALE_SOURCE}" == "socket" ]]; then
      if [[ -f "${TAILSCALE_SOCKET_OVERRIDE}" ]]; then
        COMPOSE_FILES+=("-f" "${TAILSCALE_SOCKET_OVERRIDE}")
      else
        log_warning "Tailscale socket override not found at ${TAILSCALE_SOCKET_OVERRIDE}"
        log_info "Peer discovery will report the daemon as unreachable until it is restored"
      fi
    fi
  fi

  export COMPOSE_PROFILES="${profiles}"
}

apply_optional_stacks

# Helper function to get a service's mapped port
get_service_port() {
  local service_name="$1"
  local internal_port="$2"
  dc_cmd port "${service_name}" "${internal_port}" 2>/dev/null | cut -d':' -f2
}

# Display DNS environment variables if any are set
show_dns_env_vars() {
  local force_show="${1:-false}"

  # Show if any DNS env vars are set OR if force_show is true
  if [[ "${force_show}" == "true" ]] || [[ -n "${HTTP_PROXY_DNS_TLDS:-}${HTTP_PROXY_DNS_TARGET_IP:-}${HTTP_PROXY_DNS_PORT:-}" ]]; then
    echo -e "\nDNS Proxy Configuration:"
    echo "  HTTP_PROXY_DNS_TLDS: ${HTTP_PROXY_DNS_TLDS:-loc} (default: loc)"
    echo "  HTTP_PROXY_DNS_TARGET_IP: ${HTTP_PROXY_DNS_TARGET_IP:-127.0.0.1} (default: 127.0.0.1)"
    echo "  HTTP_PROXY_DNS_PORT: ${HTTP_PROXY_DNS_PORT:-19322} (default: 19322)"
    echo
  fi
}

# Process TLD list and execute callback for each valid TLD
process_tlds() {
  local dns_tlds="${HTTP_PROXY_DNS_TLDS:-loc}"
  local callback="$1"

  IFS=',' read -ra TLDS <<< "${dns_tlds}"
  for tld in "${TLDS[@]}"; do
    tld="${tld// /}"  # Remove spaces
    tld="${tld#.}"    # Remove leading dot
    [[ -n "${tld}" ]] && "${callback}" "${tld}"
  done
}

# Warn about unmanaged macOS resolver files that might conflict
_warn_on_unmanaged_macos_dns_files() {
  [[ ! -d "/etc/resolver" ]] && return 0

  local current_tlds=()
  _get_current_tlds() { current_tlds+=("$1"); }
  process_tlds "_get_current_tlds"

  local unmanaged_files=()
  for resolver_file in /etc/resolver/*; do
    [[ -f "${resolver_file}" ]] || continue
    local filename
    filename=$(basename "${resolver_file}")

    # Skip if managed by current config
    local is_managed=false
    for tld in "${current_tlds[@]}"; do
      [[ "${filename}" == "${tld}" ]] && is_managed=true && break
    done
    [[ "${is_managed}" == "true" ]] && continue

    # Warn if it looks like our config but is unmanaged
    if grep -q "nameserver 127.0.0.1" "${resolver_file}" 2>/dev/null; then
      unmanaged_files+=(".${filename}")
    fi
  done

  if [[ ${#unmanaged_files[@]} -gt 0 ]]; then
    log_warning "Found unmanaged DNS resolver files: ${unmanaged_files[*]}"
    log_info "These may conflict with current configuration. Remove manually if no longer needed."
  fi
}

# Configure macOS DNS resolver for specific domains
configure_macos_dns() {
  [[ "${OSTYPE}" != "darwin"* ]] && return 0

  local dns_port="${HTTP_PROXY_DNS_PORT:-19322}"

  # Configure each TLD
  configure_tld() {
    local tld="$1"
    local resolver_file="/etc/resolver/${tld}"
    local expected_content="nameserver 127.0.0.1\nport ${dns_port}\n"

    # Check if file is already up to date
    if [[ -f "${resolver_file}" ]] && [[ "$(cat "${resolver_file}")" == "$(printf '%b' "${expected_content}")" ]]; then
      log_success "DNS configuration is already up to date for .${tld} (${resolver_file})"
      return 0
    fi

    # Create/update resolver file
    log_info "Creating ${resolver_file} file (sudo needed)"
    if sudo mkdir -p /etc/resolver && printf '%b' "${expected_content}" | sudo tee "${resolver_file}" >/dev/null; then
      log_success "DNS configuration succeeded for .${tld} (${resolver_file})"
    else
      log_error "DNS configuration failed for .${tld} (${resolver_file})"
    fi
  }

  process_tlds "configure_tld"
}

# Configure Linux systemd-resolved for specific domains
configure_linux_dns() {
  [[ "${OSTYPE}" == "darwin"* ]] && return 0
  ! command -v systemctl >/dev/null 2>&1 && return 0

  local dns_port="${HTTP_PROXY_DNS_PORT:-19322}"
  local resolved_config="/etc/systemd/resolved.conf.d/http-proxy.conf"
  local domains=""

  # Build domains list
  build_domain() { domains="${domains}~$1 "; }
  process_tlds "build_domain"
  domains="${domains% }"  # Remove trailing space
  [[ -z "${domains}" ]] && return 0

  local expected_content="[Resolve]\nDNS=127.0.0.1:${dns_port}\nDomains=${domains}\n"

  # Check if file needs to be created or updated
  local needs_update=true
  if [[ -f "${resolved_config}" ]] && [[ "$(cat "${resolved_config}")" == "$(printf '%b' "${expected_content}")" ]]; then
    needs_update=false
    log_success "DNS configuration is already up to date (${resolved_config})"
    return 0
  fi

  # Create/update configuration and restart service
  log_info "Creating ${resolved_config} file (sudo needed)"
  if sudo mkdir -p /etc/systemd/resolved.conf.d && printf '%b' "${expected_content}" | sudo tee "${resolved_config}" >/dev/null; then
    log_success "DNS configuration succeeded (${resolved_config})"
    sudo systemctl restart systemd-resolved >/dev/null 2>&1 || true
  else
    log_error "DNS configuration failed (${resolved_config})"
  fi
}

# Configure system DNS for the proxy domains
configure_system_dns() {
  # Show DNS configuration being used (force show all values including defaults)
  show_dns_env_vars true

  if [[ "${OSTYPE}" == "darwin"* ]]; then
    configure_macos_dns
  else
    configure_linux_dns
  fi
}

# Generate bash/zsh completion script
generate_completion() {
  local script_name
  script_name=$(basename "${0}")

  cat <<EOF
# Bash/Zsh completion for ${script_name}
_${script_name//-/_}_completion() {
    local cur prev commands services
    COMPREPLY=()
    cur="\${COMP_WORDS[COMP_CWORD]}"
    prev="\${COMP_WORDS[COMP_CWORD-1]}"

    # Available commands
    commands="version help self-test start status hosts restart start-with-metrics stop-metrics clean destroy logs dashboard grafana prometheus configure-dns completion install-completion generate-mkcert list-certs remove-cert upgrade self-update up down pull build ps top exec show-config start-with-tailscale stop-tailscale tailscale-peers tailscale-status"

    # Available services for logs command
    services="traefik dinghy_layer join_networks dns tailscale_peers prometheus grafana"

    case "\${prev}" in
        logs)
            COMPREPLY=( \$(compgen -W "\${services}" -- \${cur}) )
            return 0
            ;;
        generate-mkcert|remove-cert)
            # No completion for domain names
            return 0
            ;;
        hosts)
            COMPREPLY=( \$(compgen -W "list describe --json" -- \${cur}) )
            return 0
            ;;
        tailscale-peers)
            COMPREPLY=( \$(compgen -W "--json --refresh" -- \${cur}) )
            return 0
            ;;
        *)
            ;;
    esac

    # Complete commands
    COMPREPLY=( \$(compgen -W "\${commands}" -- \${cur}) )
    return 0
}

# Register completion function
if [[ -n \${ZSH_VERSION-} ]]; then
    # Zsh completion
    autoload -U compinit && compinit
    autoload -U bashcompinit && bashcompinit
fi

complete -F _${script_name//-/_}_completion ${script_name}
EOF
}

# Install completion script to shell profile
install_completion() {
  local script_path
  script_path=$(realpath "${0}")
  local shell_profile

  # Determine shell profile file
  if [[ -n "${ZSH_VERSION-}" ]] || [[ "${SHELL}" == *zsh* ]]; then
    shell_profile="$HOME/.zshrc"
  elif [[ -n "${BASH_VERSION-}" ]] || [[ "${SHELL}" == *bash* ]]; then
    shell_profile="${HOME}/.bashrc"
  else
    log_error "Unsupported shell. Please manually add: source <(${script_path} completion)"
    return 1
  fi

  local completion_line="source <(${script_path} completion)"

  # Check if already installed
  if grep -q "${completion_line}" "${shell_profile}" 2>/dev/null; then
    log_warning "Completion already installed in ${shell_profile}"
    return 0
  fi

  # Add completion to shell profile
  {
    echo ""
    echo "# Auto-completion for $(basename "${0}")"
    echo "${completion_line}"
  } >>"${shell_profile}"

  log_success "Completion installed to ${shell_profile}"
  log_info "Restart your terminal or run: source ${shell_profile}"
}

# Show which configuration file is being used
show_config() {
  echo "Current configuration:"
  echo "  Script location: ${SCRIPT_DIR}/$(basename "${0}")"
  echo "  Compose file: ${COMPOSE_FILE}"
  echo "  Config directory: ${CONFIG_DIR}"
  echo "  Certificate directory: ${CERT_DIR}"
  echo "  State directory: ${STATE_DIR}"
  echo ""
  echo "Tailnet peer routing:"
  echo "  Peer routing: ${TAILSCALE_ENABLED} (from ${TAILSCALE_ENABLED_ORIGIN})"
  echo "  Monitoring: ${METRICS_ENABLED} (from ${METRICS_ENABLED_ORIGIN})"
  echo "  Peer routing source: ${TAILSCALE_SOURCE} (from ${TAILSCALE_SOURCE_ORIGIN})"
  echo "  HTTP_PROXY_TAILSCALE_REFRESH_INTERVAL: ${HTTP_PROXY_TAILSCALE_REFRESH_INTERVAL:-60s} (default: 60s)"
  echo "  HTTP_PROXY_TAILSCALE_STATUS_MAX_AGE: ${HTTP_PROXY_TAILSCALE_STATUS_MAX_AGE:-10m} (default: 10m)"
  echo "  HTTP_PROXY_TAILSCALE_SOCKET: ${HTTP_PROXY_TAILSCALE_SOCKET:-/var/run/tailscale/tailscaled.sock}"
  echo "  Tailnet status document: ${TAILSCALE_STATUS_FILE}"
  echo "  Peer report: ${TAILSCALE_STATE_FILE}"
  echo ""
  echo "Configuration priority order:"
  echo "  1. User override: ${CONFIG_DIR}/compose.yml"
  echo "  2. Default (shipped): ${SCRIPT_DIR}/compose.yml"
  echo ""
  if [[ "${COMPOSE_FILE}" == "${CONFIG_DIR}/compose.yml" ]]; then
    log_success "Using user override configuration"
  elif [[ "${COMPOSE_FILE}" == "${SCRIPT_DIR}/compose.yml" ]]; then
    log_success "Using default configuration (shipped with script)"
  else
    log_info "Using custom configuration: ${COMPOSE_FILE}"
  fi
}

# Prerequisite checks
check_prerequisites() {
  local errors=0

  command -v docker >/dev/null 2>&1 || { log_error "Docker not installed or not in PATH"; ((errors++)); }
  docker info >/dev/null 2>&1 || { log_error "Docker daemon not running"; ((errors++)); }
  [[ -z "${COMPOSE_FILE}" ]] && { log_error "Docker Compose file not defined"; ((errors++)); }
  [[ -n "${COMPOSE_FILE}" && ! -f "${COMPOSE_FILE}" ]] && { log_error "Docker Compose file not found at ${COMPOSE_FILE}"; ((errors++)); }

  return ${errors}
}

# Open URL in browser
open_url() {
  local url="$1"
  local description="$2"

  log_info "Opening ${description}: ${url}"

  if command -v open >/dev/null 2>&1; then
    open "${url}"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "${url}"
  else
    echo "Cannot open browser automatically. Please visit: ${url}"
    [[ "$3" ]] && echo "$3"
    return 1
  fi
}

# Ensure prerequisites are met
# Ignore if the first argument is "help" or "version" or "completion".
if [[ "$1" != "help" && "$1" != "version" && "$1" != "completion" && "$1" != "install-completion" && "$1" != "self-update" && "$1" != "list-certs" && "$1" != "tailscale-status" ]]; then
  if ! check_prerequisites; then
    exit 1
  fi
fi

# Records an optional stack that is already running but was never recorded, so
# the first run after this change does not tear it down.
adopt_running_stacks() {
  if [[ "${METRICS_ENABLED}" != "true" ]] && [[ -z "${HTTP_PROXY_METRICS_ENABLED:-}" ]] && is_running prometheus; then
    record_stack metrics
    METRICS_ENABLED=true
    METRICS_ENABLED_ORIGIN="${OPTIONAL_STACKS_FILE}"
    log_info "Recorded the monitoring stack, which was already running"
  fi

  if [[ "${TAILSCALE_ENABLED}" != "true" ]] && [[ -z "${HTTP_PROXY_TAILSCALE_ENABLED:-}" ]] && is_running tailscale_peers; then
    record_stack tailscale
    TAILSCALE_ENABLED=true
    TAILSCALE_ENABLED_ORIGIN="${OPTIONAL_STACKS_FILE}"
    log_info "Recorded tailnet peer routing, which was already running"
  fi

  apply_optional_stacks
}

# Ensure config directories exist
mkdir -p "${CONFIG_DIR}" "${CERT_DIR}"

